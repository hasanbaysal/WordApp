@model WordApp.Models.WordItem
@using WordApp.Models

@{
    ViewData["Title"] = "Kelime Düzenle";
    var existingForms = Model?.GetForms() ?? new List<WordForm>();
    if (existingForms.Count == 0)
    {
        existingForms.Add(new WordForm { Type = WordType.Noun, Level = WordLevel.A1 });
    }
}

<!-- Quill Theme CSS CDN -->
<link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet" />

<div class="form-panel">
    <h2 class="form-title"><i class="bi bi-pencil text-primary"></i> Kelime Düzenle</h2>

    <form asp-action="Edit" id="wordForm" method="post">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger border-0 rounded-3 bg-danger bg-opacity-10 text-danger p-3 mb-4" role="alert">
                Lütfen formdaki hataları düzeltin.
            </div>
        }

        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="IsLearned" />
        <input type="hidden" asp-for="IntervalDays" />
        <input type="hidden" asp-for="NextReviewDate" />
        <input type="hidden" asp-for="LastReviewedAt" />
        <input type="hidden" asp-for="CreatedAt" />

        <div class="mb-4">
            <label asp-for="Word" class="form-label text-muted fw-500">Kelime</label>
            <input asp-for="Word" class="form-control filter-control w-100" placeholder="Örn: Serendipity" required />
            <span asp-validation-for="Word" class="text-danger small"></span>
        </div>

        <div class="word-forms-editor mb-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <label class="form-label text-muted fw-500 mb-0">Tür ve Seviye Formları</label>
                <button type="button" id="add-form-btn" class="btn btn-secondary-custom btn-sm-custom">
                    <i class="bi bi-plus-lg"></i> Form Ekle
                </button>
            </div>
            <p class="text-muted small mb-3">Bu kelimenin tüm tür ve seviye eşleşmelerini buradan yönetebilirsiniz.</p>

            <div id="forms-list" class="d-flex flex-column gap-2">
                @for (int i = 0; i < existingForms.Count; i++)
                {
                    var form = existingForms[i];
                    <div class="word-form-row">
                        <div class="flex-grow-1">
                            <select name="forms[@i].Type" class="form-select filter-control w-100 form-type-select" required>
                                @foreach (var type in Enum.GetValues<WordType>())
                                {
                                    <option value="@type" selected="@(form.Type == type ? "selected" : null)">@type.ToTurkishLabel()</option>
                                }
                            </select>
                        </div>
                        <div class="word-form-level-col">
                            <select name="forms[@i].Level" class="form-select filter-control w-100 form-level-select" required>
                                @foreach (var level in Enum.GetValues<WordLevel>())
                                {
                                    <option value="@level" selected="@(form.Level == level ? "selected" : null)">@level</option>
                                }
                            </select>
                        </div>
                        <button type="button" class="btn btn-secondary-custom btn-sm-custom text-danger remove-form-btn" title="Formu Kaldır">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                }
            </div>
            @if (ViewData.ModelState.TryGetValue("Forms", out var formsState) && formsState.Errors.Count > 0)
            {
                <span class="text-danger small d-block mt-2">@formsState.Errors[0].ErrorMessage</span>
            }
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label asp-for="UkMp3" class="form-label text-muted fw-500">İngiliz Aksanı Telaffuz (UK MP3 Link)</label>
                <input asp-for="UkMp3" class="form-control filter-control w-100" placeholder="https://..." />
                <span asp-validation-for="UkMp3" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="UsMp3" class="form-label text-muted fw-500">Amerikan Aksanı Telaffuz (US MP3 Link)</label>
                <input asp-for="UsMp3" class="form-control filter-control w-100" placeholder="https://..." />
                <span asp-validation-for="UsMp3" class="text-danger small"></span>
            </div>
        </div>

        <div class="mb-4">
            <label class="form-label text-muted fw-500">Notlar ve Örnek Cümleler</label>
            <!-- Quill Editor Container -->
            <div id="editor-container"></div>
            <!-- Hidden textarea to bind with model -->
            <textarea asp-for="Notes" style="display:none;" id="notes-textarea"></textarea>
            <span asp-validation-for="Notes" class="text-danger small"></span>
        </div>

        <div class="d-flex gap-3 mt-5">
            <button type="submit" class="btn-indigo">
                <i class="bi bi-check-lg"></i> Değişiklikleri Kaydet
            </button>
            <a asp-action="Index" class="btn-secondary-custom">
                <i class="bi bi-x-circle"></i> İptal
            </a>
        </div>
    </form>
</div>

<template id="word-form-row-template">
    <div class="word-form-row">
        <div class="flex-grow-1">
            <select class="form-select filter-control w-100 form-type-select" required>
                @foreach (var type in Enum.GetValues<WordType>())
                {
                    <option value="@type">@type.ToTurkishLabel()</option>
                }
            </select>
        </div>
        <div class="word-form-level-col">
            <select class="form-select filter-control w-100 form-level-select" required>
                @foreach (var level in Enum.GetValues<WordLevel>())
                {
                    <option value="@level">@level</option>
                }
            </select>
        </div>
        <button type="button" class="btn btn-secondary-custom btn-sm-custom text-danger remove-form-btn" title="Formu Kaldır">
            <i class="bi bi-trash"></i>
        </button>
    </div>
</template>

@section Scripts {
    <!-- Quill Library JS CDN -->
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>
    <script>
        $(document).ready(function () {
            function reindexFormRows() {
                var $rows = $("#forms-list .word-form-row");
                $rows.each(function (index) {
                    $(this).find(".form-type-select").attr("name", `forms[${index}].Type`);
                    $(this).find(".form-level-select").attr("name", `forms[${index}].Level`);
                });
                $rows.find(".remove-form-btn").prop("disabled", $rows.length <= 1);
            }

            $("#add-form-btn").click(function () {
                var tpl = document.getElementById("word-form-row-template");
                $("#forms-list").append(tpl.content.cloneNode(true));
                reindexFormRows();
            });

            $(document).on("click", ".remove-form-btn", function () {
                if ($("#forms-list .word-form-row").length <= 1) return;
                $(this).closest(".word-form-row").remove();
                reindexFormRows();
            });

            reindexFormRows();

            // Initialize Quill Editor
            var quill = new Quill('#editor-container', {
                theme: 'snow',
                placeholder: 'Kelimelerin Türkçe anlamlarını, örnek cümlelerini ve çalışma notlarını buraya ekleyin...',
                modules: {
                    toolbar: [
                        ['bold', 'italic', 'underline', 'strike'],
                        [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                        ['clean']
                    ]
                }
            });

            // Load existing notes HTML into Quill editor
            var initialContent = $("#notes-textarea").val();
            if (initialContent) {
                quill.root.innerHTML = initialContent;
            }

            // Bind Quill content to hidden textarea on form submit
            var form = document.getElementById('wordForm');
            form.onsubmit = function () {
                reindexFormRows();
                var notesTextarea = document.getElementById('notes-textarea');
                notesTextarea.value = quill.root.innerHTML === '<p><br></p>' ? '' : quill.root.innerHTML;
            };
        });
    </script>
}
